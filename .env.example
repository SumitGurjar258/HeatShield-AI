# HeatShield AI Environment Configuration
# Copy this file to .env and configure as needed

# Weather API Configuration
# Provider options: "open-meteo" (default, free, no key required), "openweathermap"
WEATHER_API_PROVIDER=open-meteo
OPENWEATHERMAP_API_KEY=

# Database Configuration
DATABASE_PATH=heatshield.db

# Heat-Health Alert Default Thresholds (Celsius)
HEAT_THRESHOLD_MODERATE=28.0
HEAT_THRESHOLD_HIGH=32.0
HEAT_THRESHOLD_CRITICAL=35.0
HEATWAVE_MIN_DAYS=2

# Default Regional Coordinates (e.g., Greater London / Midlands / Urban Heat Island demo)
DEFAULT_LAT=51.5074
DEFAULT_LON=-0.1278
DEFAULT_LOCATION_NAME=Greater London Health Region

# Operational Buffer Settings
BED_SAFETY_BUFFER_PCT=10.0
